# =====================================================================
# The Writers' Room — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Development can run entirely on the local Ollama backend (no cloud).
# =====================================================================

# Which model backend to use: "watsonx" (demo/prod) or "ollama" (local dev)
MODEL_BACKEND=watsonx

# ---- IBM watsonx.ai (required when MODEL_BACKEND=watsonx) ----
# Create these in IBM Cloud: https://cloud.ibm.com/registration
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# IBM Granite model served on watsonx.ai. Confirm it is provisioned for your
# watsonx project/region before changing it; this default is supported in us-south.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ---- Ollama (required when MODEL_BACKEND=ollama) ----
# Install Ollama (https://ollama.com) then: `ollama pull granite3.3`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_ID=granite3.3

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:3000

# ---- Optional: protect the demo backend from budget-DoS ----
# If set, requests to /agent/* and /generate must send header X-API-Key: <value>
WRITERS_ROOM_API_KEY=
# Set true only behind a trusted reverse proxy (Render/Railway/Fly) that sets
# X-Forwarded-For. Keep false for direct/local deployment.
TRUST_PROXY_HEADERS=false

# ---- Web app (Next.js) ----
# Base URL the browser uses to reach the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Optional: in-app scene-image rendering (Qwen / Wan via DashScope) ----
# If set, the Production panel's "Render in-app" button renders concept art.
# If blank, the cinematic image prompt is still shown + copyable into any image
# tool (Midjourney / FLUX / Replicate) — the feature never blocks the writer.
DASHSCOPE_API_KEY=
# International (Singapore) accounts use the -intl host + the wan2.2 model
# family; mainland-China accounts use dashscope.aliyuncs.com + wanx2.1-*.
DASHSCOPE_IMAGE_MODEL_ID=wan2.2-t2i-flash
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
