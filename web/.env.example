# =====================================================================
# The Writers' Room — frontend (Next.js) environment configuration
# Copy this file to `.env.local` and fill in the values you need.
#
# IMPORTANT: this is a TEMPLATE. Never commit real secrets here. The live
# `.env.local` is gitignored; this file holds only placeholders.
# =====================================================================

# ---- Database (Prisma / Story Bible storage) ----
# Local (matches docker-compose): postgresql://user:password@localhost:5432/writers_room
# Hosted (e.g. Neon free tier): paste your connection string with ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/writers_room

# ---- NextAuth (sign-in / sessions) ----
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (optional — leave blank to disable Google sign-in; email/password
# and the cookie "Try the demo" mode still work without it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Backend the browser calls ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Real-time collaboration (Liveblocks) ----
# Public key from https://liveblocks.io/dashboard. Safe to expose (it's public).
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# ---- Canonical site URL (for OpenGraph / Twitter card metadata) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Story Bible embeddings (used by the in-process embedder in
#      lib/embeddings.ts; SERVER-SIDE ONLY — never exposed to the browser, since
#      these have no NEXT_PUBLIC_ prefix). Required for addFact / searchFacts to
#      embed and retrieve facts. Leave blank to fall back to the deterministic
#      local embedder (offline dev).
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_EMBED_MODEL_ID=ibm/granite-embedding-107m-multilingual
