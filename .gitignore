# ---- Python / api ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Node / web ----
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/

# ---- Env & secrets ----
# `.env` / `.env.*` are the live, filled-in files and must never be committed.
# The `.env.example` templates are the only env files that belong in git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
gha-creds-*.json

# ---- Agent tooling (machine-specific) ----
# settings.local.json is a per-machine permission allowlist holding absolute
# paths from whichever codespace generated it. Shared config goes in
# .claude/settings.json instead.
.claude/settings.local.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Misc ----
.cache/
coverage/

# ---- Dev artifacts ----
*.patch
*.orig

# ---- Agent/session transcripts ----
# These dumps routinely contain pasted credentials (DB URLs, API keys).
# Never commit them: a `git add .` would publish live secrets.
lastsession_*.txt
prevworks_*.txt
*_chat.txt
*_conv.txt
